# scheduler.nx — the Physarum scheduler: the reinforce/decay law applied to EXECUTION.
# `schedule(name, workers, items)` distributes a batch across a learning pool of worker-agents, runs the
# chunks on real worker threads IN PARALLEL, and updates each worker's conductance from its measured speed —
# so fast workers pull more of the flux on later calls, and a failed worker decays and its items reroute.
#
# A worker takes a CHUNK (a list of items) and returns a results list — one result per item, in order.

# --- a simple homogeneous pool: square every number, across two workers, in parallel ---
agent square(chunk) {
  seed out = []
  for each x in chunk { out = out + [x * x] }
  report out
}

emit "squares: " + str(schedule("squares", [square, square], [1, 2, 3, 4, 5, 6, 7, 8]))

# --- a heterogeneous pool: one fast worker, one slow worker; watch the pool LEARN ---
agent fast(chunk) {
  seed out = []
  for each x in chunk { out = out + [x] }
  report out
}
agent slow(chunk) {
  seed out = []
  for each x in chunk {
    seed j = 0
    reinforce j < 300000 { j = j + 1 }      # this tube is genuinely slower
    out = out + [x]
  }
  report out
}

# run a few batches so the pool can measure speed and re-balance the flux
reinforce 4 times {
  schedule("work", [fast, slow], [1, 2, 3, 4, 5, 6, 7, 8])
}
emit "learned conductances (fast should dominate): " + str(flows("work"))

# --- failover: a dead tube; its work reroutes to the survivor, result intact ---
agent boom(chunk) { fail "this tube is dead" }
agent ok(chunk) {
  seed out = []
  for each x in chunk { out = out + [x * 10] }
  report out
}
emit "failover (boom dies, ok takes over): " + str(schedule("resilient", [boom, ok], [1, 2, 3]))
