# geo.nx — a small geometry strand. Only the names it `expose`s escape it.

agent area_circle(r) { report PI * r * r }
agent area_rect(w, h) { report w * h }
seed TAU = PI * 2

# a private helper — defined here, but NOT exposed, so it stays inside the strand.
agent secret() { report "hidden" }

expose area_circle
expose area_rect
expose TAU
