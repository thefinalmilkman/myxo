# resilient.nx — error handling + the expanded stdlib, the Nexus way.
# Shows: words/split, mesh-as-counter, value-returning `or`, attempt/rescue/fail.

# Rank words by how often they appear (split + mesh + the `or default` idiom).
agent word_counts(text) {
  seed counts = {}
  for each w in words(lower(text)) {
    counts[w] = (counts[w] or 0) + 1   # missing key is void; void or 0 -> 0
  }
  report counts
}

seed text = "the mesh reinforces the path the mesh keeps"
emit "counts:", word_counts(text)

# A safe lookup: a pathway that might not exist, handled instead of crashing.
agent safe_strength(counts, key) {
  attempt {
    when not has(counts, key) { fail "no such pathway: " + key }
    report counts[key]
  } rescue err {
    report err["message"]    # turn a failure into a graceful value
  }
}

seed counts = word_counts(text)
emit safe_strength(counts, "mesh")     # present  -> 2
emit safe_strength(counts, "wallet")   # absent   -> a clean message, no crash
