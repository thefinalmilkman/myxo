# Nx tests itself, in Nx — run:  node nx.js test tests/   (or  npm run test:nx)
# This proves Nx can EXPRESS and RUN passing tests in itself — the independence contract in action.
# Honest scope: the runner's OWN correctness (reports failures, stays inert in normal runs, isolates tests,
# never green-lights a false pass) is verified separately in test/nxtest.test.js. This .nx layer runs with no
# natives granted, so it cannot reach host capabilities (the fence / needs), modules, or the mesh.

agent add(a, b) { report a + b }
agent fib(n) { when n < 2 { report n }  report fib(n - 1) + fib(n - 2) }
agent boom() { fail "kaboom happened" }
agent shape(v) {
  match v {
    ["pt", x, y]  { report x + y }
    { "kind": k } { report k }
    [head, ...t]  { report head }
    0             { report "zero" }
    _             { report "other" }
  }
}

test "arithmetic + precedence" {
  expect 2 + 3 is 5
  expect 10 % 3 is 1
  expect 2 * 3 + 1 is 7
  expect 2 + 3 * 2 is 8
}

test "agents + recursion" {
  expect add(2, 3) is 5
  expect fib(10) is 55
}

test "booleans + truthiness" {
  expect live
  expect not dead
  expect 1 is not 2
  expect (1 < 2) is live
  expect (3 < 2) is dead
}

test "strings + stdlib" {
  expect "a" + "b" is "ab"
  expect len("hello") is 5
  expect upper("hi") is "HI"
}

test "lists: deep equality + ops" {
  expect [1, 2, 3] is [1, 2, 3]
  expect [1, [2, 3]] is [1, [2, 3]]
  expect len([1, 2, 3]) is 3
  expect first([1, 2, 3]) is 1
  expect last([1, 2, 3]) is 3
}

test "meshes: deep equality is order-insensitive" {
  seed m = { "a": 1, "b": 2 }
  expect m["a"] is 1
  expect { "a": 1, "b": 2 } is { "b": 2, "a": 1 }
  expect { "a": 1 } is not { "a": 2 }
}

test "value-returning or / and" {
  expect (void or 7) is 7
  expect (5 or 7) is 5
  expect (live and 3) is 3
}

test "pattern matching: literals, lists, meshes, rest, catch-all" {
  expect shape(["pt", 3, 4]) is 7
  expect shape({ "kind": "ping" }) is "ping"
  expect shape([9, 8, 7]) is 9
  expect shape(0) is "zero"
  expect shape("x") is "other"
}

agent typed_add(a: number, b: number): number { report a + b }

test "gradual types: typed code runs under strict (nx test is strict)" {
  expect typed_add(2, 3) is 5
  seed n: number = 42
  expect n is 42
}

test "pipelines + destructuring" {
  seed [head, ...others] = [10, 20, 30]
  expect head is 10
  expect others is [20, 30]
  seed { a, b } = { "a": 1, "b": 2 }
  expect a is 1
  expect b is 2
  expect (3 | add(4)) is 7
}

test "failure: rescuable AND assertable" {
  seed caught = "none"
  attempt { boom() } rescue e { caught = e["message"] }
  expect caught is "kaboom happened"
  expect boom() to fail
  expect boom() to fail with "kaboom"
}
