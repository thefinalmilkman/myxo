test "three distinct" { expect doubleAll([1, 2, 3]) is [2, 4, 6] }
test "three same"     { expect doubleAll([5, 5, 5]) is [10, 10, 10] }
test "three with zero"{ expect doubleAll([0, 1, 2]) is [0, 2, 4] }
test "four"           { expect doubleAll([1, 2, 3, 4]) is [2, 4, 6, 8] }
test "two order"      { expect doubleAll([3, 7]) is [6, 14] }
test "single"         { expect doubleAll([4]) is [8] }
test "empty"          { expect doubleAll([]) is [] }
